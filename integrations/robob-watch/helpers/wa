#!/bin/zsh
# wa — WhatsApp CLI for agents, backed by wacli (durable SQLite store kept live by LaunchAgent com.ardud.wacli-sync).
# Same interface as the old whatscli/tmux wrapper (retired; it sent without approval, so `wa tui` is gone).
# Usage:
#   wa status                 "online pid N" if the sync daemon is up (exit 1 otherwise)
#   wa find <name|number>     search contacts -> jid | name | push name (lists phone JID and LID)
#   wa check <number...> [--local-only]   is it on WhatsApp? local store first; misses get ONE live check that
#                             pauses the sync daemon for at most ~25s (--local-only never goes live; exit 3 = busy, retry)
#   wa chats [N]              recent chats: name (unread) | jid
#   wa read <jid> [--more N]  last 40 messages "(dd-mm-yy HH:MM:SS) Me|Name: text" (phone JID + LID merged);
#                             --more N shows N*40 more and asks the phone for older history when the store runs out
#   wa draft <jid> <text...>  store a single-line text draft (sends nothing); prints the preview lines to show Abdullah
#   wa draftfile <jid> <path> [--as image|video|audio|document|auto] [caption...]   same for a file (bound to its bytes)
#   wa send --approved <id> [--quiet] [--inbound <id> | --app]   send a text draft once, right away. --inbound/--app are optional
#                             and not checked. Where his OK makes sense, show him the draft preview first and send after his reply.
#   wa sendfile --approved <id> [--inbound <id> | --app]   same for a file draft
#   wa send [--quiet] <jid> <text...>   send now, to anyone (the owner's own number needs no extra flag).
#                             Prints "(sent) Me: <text>"; --quiet prints "(sent) id <msgid>" instead.
#   wa send [--quiet] <jid> -           text from stdin, through the sync daemon's socket (helpers/wa-sendtext). Always quiet.
#   wa send [--quiet] <jid> --file <path>   same, text from a file. Always quiet.
#                             Passwords and other secrets: use - or --file, so the text is on no argv and in no output.
#   wa sendfile <jid> <path> [image|video|audio|doc]   same, for a file
#   wa download <jid> [N]     download the Nth-newest media message (default 1) -> prints the file path
#   wa ids <jid> [N]          last N messages with message ids (for download/reply-to)
#   wa start                  (re)start the sync daemon
# Drafts live in $WA_DRAFT_DIR (default ~/.local/state/wa-drafts). A pending draft is never rewritten; drafting it
# again once it is over 24h old (or its file changed) renames it <id>.expired.json and makes a new id, so an old OK
# can't send it. A claimed draft is briefly <id>.sending.json; a used one is renamed
# <id>.sent.json or <id>.failed.json, never deleted.
set -u
W=${WA_WACLI:-$HOME/.local/bin/wacli}
D=${WA_DRAFT_DIR:-$HOME/.local/state/wa-drafts}
H="$HOME/.local/share/robob-watch/helpers/wa-db"
# Checks Abdullah's OK on a draft (lives next to this script; ~/.local/bin/wa is a symlink).
SA=${WA_SEND_APPROVAL:-${0:A:h}/send-approval}
DL="$HOME/Downloads/whatsapp"
norm() { local j=$1; [[ $j == *@* ]] || j="${j//[^0-9]/}@s.whatsapp.net"; print -r -- $j; }
SVC="gui/$(id -u)/com.ardud.wacli-sync"
PLIST="$HOME/Library/LaunchAgents/com.ardud.wacli-sync.plist"
# Marker read by wacli-guard: while a backfill holds the daemon down, the guard leaves it alone (until the deadline).
BACKFILL_MARK="$HOME/.wacli/.backfill-until"
LCTL=${WA_LAUNCHCTL:-launchctl}
OWNER=971585134795
re_id='^[0-9a-f]{10}$'
die() { print -r -- "$1" >&2; exit 2; }
# Read one field of a draft file (only the preview has several lines).
jget() { /usr/bin/python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' "$1" "$2"; }
# Write a draft file atomically from key=value pairs.
jput() {
  local f=$1; shift
  /usr/bin/python3 -c '
import json,os,sys
out = {}
for kv in sys.argv[2:]:
    k, _, v = kv.partition("=")
    out[k] = int(v) if k == "created_at" else v
tmp = sys.argv[1] + ".tmp"
with open(tmp, "w") as fh:
    json.dump(out, fh)
os.replace(tmp, sys.argv[1])' "$f" "$@"
}
# A draft already sent or in flight cannot be written again.
draft_free() {
  [[ -e $D/$1.sent.json ]] && die "Refused: this exact draft $1 was already sent."
  [[ -e $D/$1.sending.json ]] && die "Refused: draft $1 is already being sent."
  return 0
}
# Draft id from its content (stdin). After a failed send or an expired draft the same content gets a new id,
# so the old OK (on the old id's preview) can't send it again.
draft_id() {
  local base n=0 id
  base=$(cat)
  id=$(print -rn -- "$base" | /usr/bin/shasum -a 256 | cut -c1-10)
  while [[ -e $D/$id.failed.json || -e $D/$id.expired.json ]]; do
    (( n++ )); id=$(print -rn -- "$base"$'\n'"retry $n" | /usr/bin/shasum -a 256 | cut -c1-10)
  done
  print -r -- $id
}
# One chat, one draft id: a privacy id (LID) becomes the phone JID when wacli knows it.
canon() {
  local j=$1 pj
  if [[ $j == *@lid ]]; then
    pj=(${(M)${(f)"$("$H" resolve "$j" 2>/dev/null)"}:#*@s.whatsapp.net})
    (( ${#pj} )) && j=$pj[1]
  fi
  print -r -- $j
}
# The recipient line of a preview, with the chat's stable id: "Name (+number)", "group Name (id@g.us)". Sets TO.
recipient() {
  local jid=$1 name
  name=$("$H" name "$jid" 2>/dev/null)
  if [[ $jid == *@g.us ]]; then TO="group ${name:+$name }($jid)"
  elif [[ $jid == *@s.whatsapp.net ]]; then TO="${name:+$name (}+${jid%%@*}${name:+)}"
  else TO="${name:+$name }($jid)"; fi
}
# Print the preview lines the agent shows Abdullah where his OK makes sense (no check runs; the send isn't held).
show_preview() {
  print -r -- "Preview (to get Abdullah's OK first, show him these lines as is; for Moni's own request: Moni, in her chat; in a Robob thread: alone in a plain \`\`\` code block):"
  print -r -- "$3"
  print -r -- "Send: wa $2 --approved $1"
}
# Message id from a JSON reply on stdin: wacli's {"success":true,"data":{"id":...}} or wa-sendtext's {"id":...}.
# Piped to python through the print builtin, so no external process gets the reply on its argv.
msgid() {
  print -r -- "$1" | /usr/bin/python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    d = {}
if isinstance(d, dict) and isinstance(d.get("data"), dict):
    d = d["data"]
print(d.get("id", "") if isinstance(d, dict) else "")' 2>/dev/null
}
# Printed after a send to someone other than the owner. Stderr, so stdout stays the sent line.
tip() { [[ ${1%%@*} == $OWNER ]] || print -r -- "Tip: when a message speaks for Abdullah with new wording, money, dates or a commitment, show him a wa draft preview first." >&2; }
# A pending draft with this id is kept as is while it is fresh (same preview, same clock). Over 24h old, or its
# file gone or changed: it becomes <id>.expired.json and this prints nothing (the caller takes a new id).
# Prints the stored preview and exits when it is still fresh.
reuse_pending() {
  local id=$1 cmd=$2 f=$D/$1.json created fp
  [[ -f $f ]] || return 0
  created=$(jget "$f" created_at)
  if [[ $created == <-> ]] && (( $(date +%s) - created <= 86400 )) && [[ -n $(jget "$f" preview) ]]; then
    fp=$(jget "$f" path)
    if [[ $(jget "$f" kind) != file ]] || [[ -f $fp && $(/usr/bin/shasum -a 256 "$fp" | cut -c1-64) == $(jget "$f" sha256) ]]; then
      print -r -- "DRAFT $id (already pending, unchanged)"
      show_preview $id $cmd "$(jget "$f" preview)"
      exit 0
    fi
  fi
  mv "$f" "$D/$id.expired.json"
}
# The id for a draft's content (stdin of draft_id), locked: a pending fresh one is printed and the script exits
# (reuse_pending); one retired while we waited for its lock (failed or expired by another wa) moves on to the
# next id. Sets ID.
pick_id() {
  local base=$1 cmd=$2
  while true; do
    ID=$(print -rn -- "$base" | draft_id)
    lock_draft "$ID"
    [[ -e $D/$ID.failed.json || -e $D/$ID.expired.json ]] && continue
    draft_free "$ID"
    reuse_pending "$ID" $cmd
    [[ -e $D/$ID.expired.json ]] || return 0
  done
}
# One drafter or sender per draft id at a time; held until this process exits.
lock_draft() {
  mkdir -p "$D/locks" && zmodload zsh/system && : >> "$D/locks/$1" && zsystem flock -t 60 "$D/locks/$1" \
    || die "Refused: draft $1 is busy (another wa is writing or sending it). Try again in a minute."
}
# Claim an approved draft of the given kind (text|file): hard-link it to <id>.sending.json (fails if that exists).
claim_draft() {
  local id=$1 kind=$2 f=$D/$1.json k created s fp sha
  [[ $id =~ $re_id ]] || die "error: bad draft id: $id"
  lock_draft "$id"
  for s in sent sending failed uncertain expired; do
    [[ -e $D/$id.$s.json ]] && die "Refused: draft $id already used ($s). Write a new draft."
  done
  [[ -f $f ]] || die "Refused: no draft $id. Write one with wa draft or wa draftfile."
  k=$(jget "$f" kind)
  [[ $k == $kind ]] || die "Refused: draft $id is a $k draft, not $kind."
  created=$(jget "$f" created_at)
  [[ $created == <-> ]] || die "Refused: draft $id has no valid timestamp."
  (( $(date +%s) - created > 86400 )) && die "Refused: draft $id is older than 24h. Write a new draft."
  if [[ $kind == file ]]; then
    fp=$(jget "$f" path); sha=$(jget "$f" sha256)
    [[ -n $sha ]] || die "Refused: draft $id predates file binding. Write a new draft with wa draftfile."
    [[ -f $fp ]] || die "Refused: file is gone: $fp"
    [[ $(/usr/bin/shasum -a 256 "$fp" | cut -c1-64) == $sha ]] || die "Refused: $fp changed since draft $id. Write a new draft and show it again."
  fi
  { ln "$f" "$D/$id.sending.json" 2>/dev/null && rm -f "$f"; } || die "Refused: draft $id already used."
  CLAIMED=$D/$id.sending.json
}
settle() { mv "$CLAIMED" "${CLAIMED%.sending.json}.$1.json"; }
# (Re)load the sync agent: bootstrap if launchd lost it (bootout), kickstart otherwise.
sync_up() {
  if "$LCTL" print "$SVC" >/dev/null 2>&1; then "$LCTL" kickstart -k "$SVC"
  else "$LCTL" bootstrap "gui/$(id -u)" "$PLIST" || "$LCTL" kickstart -k "$SVC"; fi
}

# One daemon pause at a time (wa check and wa read --more): held until this process exits.
live_lock() {
  local f="$HOME/.wacli/.wa-check.lock"
  mkdir -p "${f:h}" && zmodload zsh/system && : >> "$f" && zsystem flock -t ${WA_LOCK_WAIT:-35} "$f"
}

sub=${1:-help}; shift 2>/dev/null
# Test runs never reach WhatsApp: a draft or send under a test needs a stub wacli injected via WA_WACLI.
case $sub in
  draft|draftfile|send|sendfile)
    if [[ -n ${ROBOB_TEST:-} || ${NODE_ENV:-} == test || -n ${PYTEST_CURRENT_TEST:-} ]] && [[ -z ${WA_WACLI:-} ]]; then
      print -r -- "refused: test run; wa $sub would reach WhatsApp (set WA_WACLI to a stub)" >&2; exit 2
    fi ;;
esac
case $sub in
  status) "$H" health ;;
  start)
    sync_up || exit 1
    for i in {1..10}; do sleep 2; "$H" health >/dev/null 2>&1 && break; done
    "$H" health ;;
  find) "$H" find "$*" ;;
  check)
    # 19 Oct 2026: `wacli contacts check` needs the store lock the sync daemon holds, so direct calls all failed.
    # The local store answers without the lock; only numbers it doesn't know get one live call, daemon paused.
    local_only=0; nums=()
    for a in "$@"; do if [[ $a == --local-only ]]; then local_only=1; else nums+=("$a"); fi; done
    (( ${#nums} )) || die "usage: wa check <number> [number...] [--local-only]"
    loc=$("$H" check "${nums[@]}") || exit $?
    lines=(${(f)loc})
    unknown=(${${(M)lines:#+<->" | unknown locally"}%% | *})
    if (( local_only || ! ${#unknown} )); then print -l -- $lines; exit 0; fi
    # One daemon pause at a time: a parallel wa check waits for this one instead of fighting over the store lock.
    if ! live_lock; then
      print -l -- $lines
      print -r -- "wa check: another live check or history backfill is running; try again in a minute" >&2; exit 3
    fi
    # A backfill started by an older wa (no lock) may still have the daemon down: don't race it.
    if [[ -f $BACKFILL_MARK ]]; then
      until_ts=$(<"$BACKFILL_MARK")
      if [[ $until_ts == <-> ]] && (( $(date +%s) < until_ts )); then
        print -l -- $lines
        print -r -- "wa check: the sync daemon is paused for a history backfill (until $(date -r $until_ts +%H:%M:%S)); run the live check again after that" >&2; exit 3
      fi
    fi
    # Same bounded pause as wa read --more: wacli-guard leaves the daemon down until the marker's deadline,
    # the daemon is reloaded on any exit or signal, and the wacli call is capped (~25s in total).
    print -r -- $(( $(date +%s) + 60 )) > "$BACKFILL_MARK"
    # Runs once: zsh keeps the script-level EXIT trap even after `trap -` inside a function.
    restored=0
    restore() {
      (( restored )) && return 0; restored=1
      # bootstrap right after bootout can fail (error 5) while launchd is still tearing down: retry once, then kickstart.
      "$LCTL" bootstrap "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 \
        || { sleep 1; "$LCTL" bootstrap "gui/$(id -u)" "$PLIST" >/dev/null 2>&1 || "$LCTL" kickstart -k "$SVC" >/dev/null 2>&1; }
      rm -f "$BACKFILL_MARK"
    }
    trap restore EXIT; trap 'restore; exit 130' INT TERM HUP
    deadline=$(( SECONDS + 25 ))
    "$LCTL" bootout "$SVC" >/dev/null 2>&1
    left=$(( deadline - SECONDS )); (( left < 5 )) && left=5
    out=$("$W" --json --timeout ${left}s --lock-wait 8s contacts check "${unknown[@]}" 2>&1); rc=$?
    restore
    daemon="the sync daemon was reloaded"
    if ! "$LCTL" print "$SVC" >/dev/null 2>&1; then
      daemon="the sync daemon did NOT reload, run: wa start"
      print -r -- "warning: $daemon" >&2
    fi
    print -r -- "$out" | /usr/bin/python3 -c '
import json, sys
rc, daemon, lines = int(sys.argv[1]), sys.argv[2], sys.argv[3:]
res, errs, other = None, [], []
for raw in sys.stdin.read().splitlines():
    try:
        d = json.loads(raw)
    except ValueError:
        d = None
    if isinstance(d, dict) and d.get("success") is True and isinstance(d.get("data"), list):
        res = {str(r.get("phone", "")).lstrip("+"): r for r in d["data"] if isinstance(r, dict)}
    elif isinstance(d, dict) and d.get("error"):
        errs.append(str(d["error"]))
    elif raw.strip():
        other.append(raw.strip())
ok = rc == 0 and res is not None
for l in lines:
    n, _, rest = l.partition(" | ")
    if rest != "unknown locally":
        print(l)
        continue
    r = (res or {}).get(n.lstrip("+")) if ok else None
    if not ok:
        print(f"{n} | unknown (live check failed)")
    elif r and r.get("registered"):
        jid = r.get("jid") or n.lstrip("+") + "@s.whatsapp.net"
        print(f"{n} | on WhatsApp | {jid}")
    elif r and r.get("responded"):
        print(f"{n} | NOT on WhatsApp")
    else:
        print(f"{n} | no answer from WhatsApp (unknown, try again later)")
if not ok:
    why = "; ".join(errs) or " / ".join(other)[:300] or "no output"
    print(f"wa check: live check failed (wacli exit {rc}): {why}; {daemon}", file=sys.stderr)
    sys.exit(1)' $rc "$daemon" "${lines[@]}" ;;
  chats) "$H" chats ${1:-40} ;;
  read)
    jid=$(norm ${1:?usage: wa read <jid> [--more N]}); shift
    limit=40
    if [[ ${1:-} == --more ]]; then
      more=${2:-1}; limit=$(( 40 * (more + 1) ))
      have=$("$H" read "$jid" --limit $limit 2>/dev/null | grep -c '^(')
      if (( have < limit )); then
        # Older history lives only on the phone. backfill needs the store lock, so briefly stop the daemon.
        # 4 Oct 2026: a caller's 120s timeout killed this mid-backfill and the daemon stayed booted out for 3h.
        # So: bounded total time (~75s), and the daemon is reloaded on any exit or signal; wacli-guard
        # restores it anyway once the marker's deadline passes.
        # Same lock as wa check, so a live contacts check and a backfill never pause the daemon at once.
        # 25s lock wait keeps the worst case (25 + 1 + 75 + 3) inside a caller's 120s timeout. Busy = exit 3, like wa check.
        WA_LOCK_WAIT=${WA_LOCK_WAIT:-25} live_lock || { print -u2 "wa read --more: a live wa check is running; try again in a minute"; exit 3; }
        print -r -- $(( $(date +%s) + 150 )) > "$BACKFILL_MARK"
        restore() {
          trap - EXIT INT TERM HUP
          "$LCTL" bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null \
            || { sleep 1; "$LCTL" bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || "$LCTL" kickstart -k "$SVC" 2>/dev/null; }
          rm -f "$BACKFILL_MARK"
        }
        trap restore EXIT; trap 'restore; exit 130' INT TERM HUP
        "$LCTL" bootout "$SVC" 2>/dev/null; sleep 1
        (( more > 2 )) && more=2
        deadline=$(( SECONDS + 75 ))
        for c in $("$H" resolve "$jid"); do
          left=$(( deadline - SECONDS )); (( left < 10 )) && break
          "$W" history backfill --chat "$c" --requests $more --count 50 --wait $(( left < 30 ? left : 30 ))s --timeout ${left}s >/dev/null 2>&1
        done
        restore; sleep 3
      fi
    fi
    "$H" read "$jid" --limit $limit ;;
  ids)
    jid=$(norm ${1:?usage: wa ids <jid> [N]}); n=${2:-10}
    q=$("$H" resolve "$jid" | sed "s/.*/'&'/" | paste -sd, -)
    sqlite3 -readonly -separator ' | ' "file:$HOME/.wacli/wacli.db?mode=ro" \
      "select msg_id, chat_jid, datetime(ts,'unixepoch','localtime'), case from_me when 1 then 'Me' else coalesce(nullif(sender_name,''),sender_jid) end, coalesce(media_type,''), substr(replace(coalesce(text,display_text,''),char(10),' / '),1,80) from messages where chat_jid in ($q) and deleted_at is null order by ts desc limit $n" ;;
  draft)
    jid=$(canon "$(norm ${1:?usage: wa draft <jid> <text...>})"); shift
    text="${*}"
    [[ $text == *$'\n'* ]] && die "error: single-line text only"
    [[ -n $text ]] || die "error: empty text"
    base=$(printf '%s\n%s\n%s' text "$jid" "$text")
    pick_id "$base" send; id=$ID
    recipient "$jid"
    pv=$(print -rl -- "WhatsApp to $TO:" "$text" "(draft $id)")
    "$SA" visible "$pv" || exit 2
    jput "$D/$id.json" kind=text jid="$jid" text="$text" preview="$pv" created_at=$(date +%s)
    print -r -- "DRAFT $id to $jid: $text"
    show_preview $id send "$pv" ;;
  draftfile)
    jid=$(canon "$(norm ${1:?usage: wa draftfile <jid> <path> [--as image|video|audio|document|auto] [caption...]})"); file=${2:?file}; shift 2
    as=auto
    if [[ ${1:-} == --as ]]; then as=${2:?--as needs a kind}; shift 2; fi
    case $as in
      image|video|audio|document|auto) ;;
      doc) as=document ;;
      *) die "error: --as image|video|audio|document|auto" ;;
    esac
    [[ -f $file ]] || die "error: no such file: $file"
    abs=${file:a}
    caption="${*}"
    [[ $caption == *$'\n'* ]] && die "error: single-line caption only"
    sha=$(/usr/bin/shasum -a 256 "$abs" | cut -c1-64)
    # The file's bytes, not its path, make the draft: a copy elsewhere is the same draft.
    base=$(printf '%s\n%s\n%s\n%s\n%s' file "$jid" "$as" "$caption" "$sha")
    pick_id "$base" sendfile; id=$ID
    recipient "$jid"
    pv=$(print -rl -- "WhatsApp to $TO: file $abs [$as] (sha256 ${sha[1,12]})" ${caption:+"Caption: $caption"} "(draft $id)")
    "$SA" visible "$pv" || exit 2
    jput "$D/$id.json" kind=file jid="$jid" path="$abs" as="$as" caption="$caption" sha256="$sha" preview="$pv" created_at=$(date +%s)
    print -r -- "DRAFT $id to $jid: file ${abs:t} [$as]${caption:+ caption: $caption}"
    show_preview $id sendfile "$pv"
    print -r -- "In iMessage, send-file him $abs in the same chat right before the preview (the file has to reach him too)." ;;
  send)
    quiet=0
    if [[ ${1:-} == --quiet ]]; then quiet=1; shift; fi
    if [[ ${1:-} == --approved ]]; then
      claim_draft "${2:?usage: wa send --approved <id> [--quiet] [--inbound <id> | --app]}" text
      [[ ${3:-} == --quiet ]] && quiet=1
      jid=$(jget "$CLAIMED" jid); text=$(jget "$CLAIMED" text)
      self=(); [[ ${jid%%@*} == $OWNER ]] && self=(--allow-self)
      out=$("$W" --json send text --to "$jid" --message "$text" $self 2>&1); rc=$?
      if (( rc == 0 )) && [[ $out == *'"success":true'* ]]; then
        settle sent
        if (( quiet )); then print -r -- "(sent) id $(msgid "$out")"
        else print -r -- "(sent) Me: $text"; fi
        tip "$jid"
      else
        settle failed; print -r -- "${out//"$text"/[message hidden]}" >&2; exit 1
      fi
      exit 0
    fi
    jid=$(norm ${1:?usage: wa send [--quiet] <jid> <text>|-|--file <path>}); shift
    if [[ ${1:-} == --quiet ]]; then quiet=1; shift; fi
    # Text from stdin or a file goes only through wa-sendtext (print is a builtin, so the text never reaches argv).
    # Trailing newlines are stripped by command substitution, as for positional text.
    secret_mode=""
    if [[ ${1:-} == - && $# -eq 1 ]]; then secret_mode=stdin; shift
    elif [[ ${1:-} == --file && $# -eq 2 ]]; then secret_mode=file; fp=$2; shift 2
    fi
    if [[ -n $secret_mode ]]; then
      if [[ -n ${ROBOB_TEST:-} || ${NODE_ENV:-} == test || -n ${PYTEST_CURRENT_TEST:-} ]] && [[ -z ${WA_SEND_SOCK:-} ]]; then
        print -r -- "refused: test run; wa send would reach WhatsApp (set WA_SEND_SOCK to a stub)" >&2; exit 2
      fi
      if [[ $secret_mode == file ]]; then
        [[ -r $fp && -f $fp ]] || { print -r -- "error: can't read $fp" >&2; exit 2; }
        text=$(<"$fp")
      else
        text=$(cat)
      fi
      [[ -n $text ]] || { print -r -- "error: empty text" >&2; exit 2; }
      [[ $text == *$'\n'* ]] && { print -r -- "error: single-line text only" >&2; exit 2; }
      self=(); [[ ${jid%%@*} == $OWNER ]] && self=(--allow-self)
      WS=${WA_SENDTEXT:-${0:A:h}/wa-sendtext}
      out=$(print -rn -- "$text" | "$WS" --to "$jid" $self); rc=$?
      if (( rc == 0 )); then
        print -r -- "(sent) id $(msgid "$out")"; tip "$jid"; exit 0
      fi
      exit $rc
    fi
    text="${*}"
    [[ $text == *$'\n'* ]] && die "error: single-line text only"
    [[ -n $text ]] || die "error: empty text"
    self=(); [[ ${jid%%@*} == $OWNER ]] && self=(--allow-self)
    out=$("$W" --json send text --to "$jid" --message "$text" $self 2>&1); rc=$?
    if (( rc == 0 )) && [[ $out == *'"success":true'* ]]; then
      if (( quiet )); then print -r -- "(sent) id $(msgid "$out")"; else print -r -- "(sent) Me: $text"; fi
      tip "$jid"
    else
      print -r -- "${out//"$text"/[message hidden]}" >&2; exit 1
    fi ;;
  sendfile)
    if [[ ${1:-} == --approved ]]; then
      claim_draft "${2:?usage: wa sendfile --approved <id> [--inbound <id> | --app]}" file
      jid=$(jget "$CLAIMED" jid); fp=$(jget "$CLAIMED" path); as=$(jget "$CLAIMED" as); caption=$(jget "$CLAIMED" caption)
      if [[ ! -f $fp || $(/usr/bin/shasum -a 256 "$fp" | cut -c1-64) != $(jget "$CLAIMED" sha256) ]]; then
        settle failed; die "Refused: $fp is gone or changed. Write a new draft."
      fi
      self=(); [[ ${jid%%@*} == $OWNER ]] && self=(--allow-self)
      cap=(); [[ -n $caption ]] && cap=(--caption "$caption")
      out=$("$W" --json send file --to "$jid" --file "$fp" --as "$as" $self "${cap[@]}" 2>&1); rc=$?
      if (( rc == 0 )) && [[ $out == *'"success":true'* ]]; then
        settle sent; print -r -- "(sent) Me: [$as] ${fp:t}"; tip "$jid"
      else
        settle failed; print -r -- "$out" >&2; exit 1
      fi
      exit 0
    fi
    jid=$(norm ${1:?usage: wa sendfile <jid> <path> [kind]}); file=${2:?file}; kind=${3:-doc}
    case $kind in image|video|audio) as=$kind;; doc|document) as=document;; *) as=auto;; esac
    self=(); [[ ${jid%%@*} == $OWNER ]] && self=(--allow-self)
    out=$("$W" --json send file --to "$jid" --file "$file" --as $as $self 2>&1); rc=$?
    if (( rc == 0 )) && [[ $out == *'"success":true'* ]]; then print -r -- "(sent) Me: [$as] ${file:t}"; tip "$jid"; else print -r -- "$out" >&2; exit 1; fi ;;
  download)
    jid=$(norm ${1:?usage: wa download <jid> [N]}); n=${2:-1}
    q=$("$H" resolve "$jid" | sed "s/.*/'&'/" | paste -sd, -)
    row=$(sqlite3 -readonly -separator $'\t' "file:$HOME/.wacli/wacli.db?mode=ro" \
      "select chat_jid, msg_id, coalesce(nullif(filename,''), msg_id), media_type from messages where chat_jid in ($q) and coalesce(media_type,'')!='' and deleted_at is null order by ts desc limit 1 offset $(( n - 1 ))")
    [[ -n $row ]] || { echo "no media message #$n in $jid" >&2; exit 1; }
    IFS=$'\t' read -r c id name mt <<< "$row"
    mkdir -p "$DL"
    out=$("$W" --json --read-only media download --chat "$c" --id "$id" --output "$DL/" 2>&1)
    p=$(print -r -- "$out" | /usr/bin/python3 -c 'import json,sys
d=json.load(sys.stdin); x=d.get("data") or {}
print(x.get("path") or x.get("Path") or x.get("local_path") or x.get("LocalPath") or "")' 2>/dev/null)
    [[ -n $p && -f $p ]] || { print -r -- "$out" >&2; exit 1; }
    print -r -- "$p" ;;
  screen|tui) die "wa tui is retired (the old whatscli wrapper is gone). Use wa send." ;;
  *) sed -n '2,29p' "$0" ;;
esac
