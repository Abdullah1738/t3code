#!/bin/zsh -f
source "${0:A:h}/toollog.zsh" time-reached "$0" "$@" || true
# time-reached ISO_TIME [TEXT...]
# Prints TEXT (or "Reminder due") once the given time has passed; prints nothing before.
# Used for iMessage reminders via robob-watch (mode notify or wake, max-fires 1).
set -e
at="$1"; shift || true
[[ -z "$at" ]] && { echo "usage: time-reached ISO_TIME [TEXT]" >&2; exit 2; }
due=$(/usr/bin/python3 -c 'import sys,datetime;print(int(datetime.datetime.fromisoformat(sys.argv[1]).timestamp()))' "$at")
now=$(date +%s)
if (( now >= due )); then
  if (( $# )); then print -r -- "$*"; else print -r -- "Reminder due ($at)"; fi
fi
exit 0
