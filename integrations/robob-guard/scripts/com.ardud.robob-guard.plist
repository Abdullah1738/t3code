<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/ardud</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONDONTWRITEBYTECODE</key>
		<string>1</string>
	</dict>
	<key>Label</key>
	<string>com.ardud.robob-guard</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-fc</string>
		<string>exec /usr/bin/python3 "$@"</string>
		<string>--</string>
		<string>/Users/ardud/.local/share/robob-guard/guard.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/ardud/.local/state/robob-guard/launchd.log</string>
	<key>StandardOutPath</key>
	<string>/Users/ardud/.local/state/robob-guard/launchd.log</string>
	<key>StartInterval</key>
	<integer>30</integer>
</dict>
</plist>
