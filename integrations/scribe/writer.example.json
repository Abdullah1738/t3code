{
  "missions": {
    "shop": {
      "title": "Shop",
      "zone": "Asia/Dubai",
      "github": { "owner": "acme-org", "ours": ["our-login"], "skipRepos": ["internal-tooling"] },
      "people": { "jane-dev": "Jane" },
      "aliases": { "pay": "payments-api" },
      "ticketPrefixes": ["SHOP"],
      "linear": { "team": "SHOP", "triageProject": "Triage" },
      "crw": { "db": "/path/to/review-workflow/data/crw.db" },
      "releases": {
        "repo": "acme-org/devops",
        "workflow": "deploy-dev-service.yml",
        "tagPattern": "^(?<service>[a-z0-9-]+?)-docs(\\d+)-dev\\.(\\d+)$",
        "serviceRepos": { "payments": "payments-service" },
        "otherRepos": ["acme-org/web"]
      },
      "docs": [{ "label": "Architecture docs", "repo": "our-login/architecture", "branch": "main" }],
      "areas": [
        { "name": "Payments", "repos": ["payments-service"] },
        { "name": "Frontends", "repos": ["web", "mobile-app"] },
        { "name": "DevOps and infra", "repos": ["devops"] }
      ],
      "defaultArea": "Other repos",
      "messages": { "kinds": ["blocker", "evidence", "decision"], "maxChars": 60000 },
      "banned": ["\\bcell-[a-z0-9-]+", "\\bseq \\d+"],
      "limits": { "daily": 60000, "update": 15000 }
    },
    "tools": {
      "title": "Tools",
      "zone": "Asia/Dubai",
      "git": { "dir": "/path/to/repo", "ref": "origin/main", "exclude": ["upstream/main"] },
      "areas": [
        { "name": "Server", "scopes": ["server", "contracts"], "paths": ["apps/server/", "packages/"] },
        { "name": "Web", "scopes": ["web"], "paths": ["apps/web/"] }
      ],
      "defaultArea": "Other"
    }
  }
}
