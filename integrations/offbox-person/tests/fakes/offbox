#!/usr/bin/env python3
"""Fake offbox for offbox-person tests. Logs every call and runs `ssh` commands against a local fake box home,
except the desktop script, which only a real box can run. `ports` serves a fake CDP endpoint, or with --reverse
just stays up like a tunnel. `run`/`release`/`save`/`keep` do nothing.

FAKE_EXIT (JSON {subcommand: code, "*": code}) makes those subcommands exit with that code without doing
anything, the way the real client reports the home server being down (93) or a run a server restart
interrupted (94). FAKE_EXIT_MATCH limits it to calls whose arguments contain that text."""

import json
import os
import subprocess
import sys
import time
from pathlib import Path
from http.server import BaseHTTPRequestHandler, HTTPServer

args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(json.dumps({"args": args, "cwd": os.getcwd(), "thread": os.environ.get("OFFBOX_THREAD"),
                        "pool": os.environ.get("OFFBOX_POOL_SIZE")}) + "\n")


def remote_cmd(a):
    return " ".join(a[a.index("--") + 1:]) if "--" in a else " ".join(a[1:])


sub = args[0] if args else ""
forced = json.loads(os.environ.get("FAKE_EXIT") or "{}")
code = forced.get(sub, forced.get("*"))
if code is not None and os.environ.get("FAKE_EXIT_MATCH", "") in " ".join(args):
    print(f"offbox: fake exit {code}", file=sys.stderr)
    sys.exit(code)
if sub == "ssh":
    responses = os.environ.get("FAKE_SSH_RESPONSES")
    if responses:
        with open(responses) as f:
            queued = json.load(f)
        if not queued:
            print("fake offbox: unexpected ssh call", file=sys.stderr)
            sys.exit(86)
        result = queued.pop(0)
        with open(responses, "w") as f:
            json.dump(queued, f)
        if not result.get("passthrough"):
            sys.stdout.write(result.get("stdout", ""))
            sys.stderr.write(result.get("stderr", ""))
            sys.exit(result["exit"])
    cmd = remote_cmd(args)
    if "bash ~/person/session.sh" in cmd:
        sys.exit(0)
    env = {k: v for k, v in os.environ.items() if k not in ("BASH_ENV", "ENV") and not k.startswith("BASH_FUNC_")}
    env["HOME"] = os.environ["FAKE_BOXHOME"]
    data = sys.stdin.buffer.read()
    if data and os.environ.get("FAKE_OFFBOX_STDIN_MATCH", "") in cmd:
        counter = Path(os.environ["FAKE_LOG"] + ".stdin-count")
        count = int(counter.read_text()) + 1 if counter.exists() else 1
        counter.write_text(str(count))
        if count <= int(os.environ.get("FAKE_OFFBOX_DROP_STDIN", "0")):
            data = b""
        elif count <= int(os.environ.get("FAKE_OFFBOX_TRUNCATE_STDIN", "0")):
            data = data[:len(data) // 2]
    sys.exit(subprocess.run(["bash", "-c", cmd], env=env, input=data).returncode)

if sub == "ports" and "--reverse" in args:
    while True:
        time.sleep(3600)

if sub == "ports":
    port = int(args[args.index("--local") + 1])

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            body = b'{"Browser": "fake"}'
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a):
            pass

    HTTPServer(("127.0.0.1", port), Handler).serve_forever()

sys.exit(0)
