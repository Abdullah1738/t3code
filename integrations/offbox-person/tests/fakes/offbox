#!/usr/bin/env python3
"""Fake offbox for offbox-person tests. Logs every call and runs `ssh` commands against a local fake box home,
except the desktop script, which only a real box can run. `ports` serves a fake CDP endpoint, or with --reverse
just stays up like a tunnel. `run`/`release`/`save`/`keep` do nothing."""

import json
import os
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, HTTPServer

args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(json.dumps({"args": args, "cwd": os.getcwd(), "thread": os.environ.get("OFFBOX_THREAD"),
                        "pool": os.environ.get("OFFBOX_POOL_SIZE")}) + "\n")


def remote_cmd(a):
    return " ".join(a[a.index("--") + 1:]) if "--" in a else " ".join(a[1:])


sub = args[0] if args else ""
# `list --all --json` / `bases --json` print the file named by FAKE_LIST_JSON / FAKE_BASES_JSON.
if sub in ("list", "bases") and os.environ.get(f"FAKE_{sub.upper()}_JSON"):
    print(open(os.environ[f"FAKE_{sub.upper()}_JSON"]).read())
    sys.exit(0)
if sub == "ssh":
    cmd = remote_cmd(args)
    if "bash ~/person/session.sh" in cmd:
        sys.exit(0)
    env = {**os.environ, "HOME": os.environ["FAKE_BOXHOME"]}
    sys.exit(subprocess.call(["bash", "-c", cmd], env=env))

if sub == "ports" and "--reverse" in args:
    while True:
        time.sleep(3600)

if sub == "ports":
    port = int(args[args.index("--local") + 1])

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            body = b'{"Browser": "fake"}'
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a):
            pass

    HTTPServer(("127.0.0.1", port), Handler).serve_forever()

sys.exit(0)
