#!/usr/bin/env python3
"""Fake cua-driver on the fake box: logs argv, and `call get_desktop_state` writes a tiny PNG where asked."""

import json
import os
import sys

with open(os.environ["FAKE_CUA_LOG"], "a") as f:
    f.write(json.dumps(sys.argv[1:]) + "\n")

if sys.argv[1:3] == ["call", "get_desktop_state"]:
    out = json.loads(sys.argv[3])["screenshot_out_file"]
    with open(out, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\nfake")
print('{"ok": true}')
