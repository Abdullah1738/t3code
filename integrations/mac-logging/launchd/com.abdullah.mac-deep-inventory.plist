<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.abdullah.mac-deep-inventory</string>
<key>ProgramArguments</key><array><string>/bin/zsh</string><string>-c</string><string>exec /usr/bin/python3 "__HOME__/.local/lib/mac-logging/deep_inventory.py"</string></array>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
<key>ProcessType</key><string>Standard</string>
<key>Nice</key><integer>10</integer>
</dict></plist>
