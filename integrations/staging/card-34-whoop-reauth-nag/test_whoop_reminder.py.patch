+    def test_only_explicit_quiet_rejections_leave_error_rollup(self):
+        clock = dt.datetime(2026,11,22,12,3,17,tzinfo=dt.timezone.utc)
+        # Whole input class: marker type/value, reason, component and name.
+        cases = [
+            ('whoop-sync','sync.run','refresh_rejected',True),
+            ('whoop-sync','sync.run','refresh_rejected',False),
+            ('whoop-sync','sync.run','refresh_rejected',None),
+            ('whoop-sync','sync.run','refresh_rejected','true'),
+            ('whoop-sync','sync.run','refresh_network',True),
+            ('whoop-sync','sync.run','token_missing',True),
+            ('whoop','sync.run','refresh_rejected',True),
+            ('whoop','cli.run','refresh_rejected',True),
+        ]
+        with mock.patch.object(log,'utcnow',return_value=clock):
+            for index,(component,name,reason,marker) in enumerate(cases):
+                props={'reason':reason,'authStage':'token_refresh','reauthPendingSinceDay':'2026-11-21'}
+                if marker is not None: props['reauthPending']=marker
+                log.emit(component,name,kind='error',ok=False,tag='reauth_needed',props=props,
+                         _now=clock+dt.timedelta(seconds=index))
+            log.emit('whoop-sync','sync.run',ok=True,_now=clock+dt.timedelta(seconds=10))
+            log.emit('whoop-sync','sync.run',kind='error',ok=False,tag='reauth_needed',
+                     props={'reason':'refresh_rejected','reauthPending':True},_now=clock+dt.timedelta(seconds=11))
+            result=log.rollup('2026-11-22')
+        self.assertIsNotNone(result)
+        self.assertEqual(result['whoop']['pendingReauthRuns'],2)
+        self.assertEqual(result['whoop']['reauthPendingSinceDay'],'2026-11-21')
+        self.assertEqual(result['errorCount'],7)
+        self.assertEqual(result['okCount'],1)
+        self.assertEqual(result['errorRate'],7/8)
+        self.assertEqual(result['countsByKind']['error'],9)
+        self.assertEqual(sum(row['count'] for row in result['topErrors']),7)
+        self.assertEqual(result['whoop']['consecutiveFailures'],6)
+        self.assertEqual(sum(row['count'] for row in result['whoop']['authFailures']),6)
+
