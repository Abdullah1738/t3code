+    def recover_expired_notice(self, original):
+        # State is read from disk on each tick, including after a process restart.
+        self.clock += dt.timedelta(hours=23, minutes=59)
+        attempts_before = len(self.notice_attempts())
+        self.assertEqual(self.invoke()[0], 1)
+        self.assertEqual(len(self.notice_attempts()), attempts_before)
+        self.clock += dt.timedelta(minutes=1)
+        self.assertEqual(self.invoke()[0], 1)
+        self.assertEqual(self.notice_attempts()[-1], original)
+        self.assertEqual(len(self.notices()), 1)
+        self.assertEqual(self.notices()[0], original)
+        self.assertEqual(self.state()['expired_notice'], {
+            'key': original['--key'], 'text': original['--text'], 'accepted': True})
+        self.assertEqual(self.state()['last_sent_at'], self.clock.isoformat())
+        self.clock += dt.timedelta(hours=25)
+        self.assertEqual(self.invoke()[0], 1)
+        self.assertEqual(len(self.notice_attempts()), attempts_before+1)
+        self.assertEqual(len(self.notices()), 1)
+        for content in (json.dumps(self.state()), json.dumps(self.notice_attempts()), json.dumps(self.rows())):
+            self.assertNotIn('Private', content)
+            self.assertNotIn('synthetic-state', content)
