+    def parsed_time(value):
+        try:
+            stamp = datetime.fromisoformat(value.replace("Z", "+00:00"))
+            return stamp.astimezone(timezone.utc) if stamp.tzinfo is not None else None
+        except (AttributeError, TypeError, ValueError):
+            return None
+
+
+    def notify_reauth(text, key):
+        # The bridge CLI only targets the paired owner; no recipient or credentials.
+        env = dict(os.environ)
+        env.pop("BUN_INSPECT", None)
+        result = subprocess.run([os.path.expanduser("~/.bun/bin/bun"),
+            os.path.expanduser("~/.local/share/telegram-bridge/src/cli.ts"), "notify",
+            "--source", "whoop-sync", "--severity", "attention", "--key", key, "--text", text],
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=25, env=env)
+        return result.returncode == 0  # durable queue acceptance, not a phone receipt
+
+
+    def record_reauth_reminder(pending, metrics):
+        # Caller holds TokenLock through the claim and send, across processes.
+        st = read_json(STATUS, {}) or {}
+        stamp = now()
+        last = parsed_time(st.get("last_sync_at"))
+        if metrics is not None:
+            metrics.update(reauthPending=pending, reminderSent=False,
+                           hoursSinceLastSuccess=round(max(0, (stamp - last).total_seconds()) / 3600, 2)
+                           if last else None)
+        path = os.path.join(os.path.dirname(STATUS), "reauth_reminder.json")
+        try:
+            state = read_json(path, {}) or {}
+            since = parsed_time(state.get("pending_since")) or stamp
+            if metrics is not None:
+                metrics["reauthPendingSinceDay"] = since.date().isoformat()
+            attempted = parsed_time(state.get("last_attempt_at"))
+            if attempted and (stamp - attempted).total_seconds() < 86400:
+                return
+            expired = state.get("expired_notice")
+            if not pending and expired and expired.get("accepted") is True:
+                return
+            day = last.date().isoformat() if last else "unknown"
+            if pending:
+                expiry = parsed_time((st.get("listener") or {}).get("until"))
+                text = ("WHOOP needs you to sign in again, data stopped %s, link valid until %s. %s"
+                        % (day, expiry.strftime("%Y-%m-%d %H:%M UTC") if expiry else "unknown", LOGIN_LINK))
+            else:
+                if not expired:
+                    expired = {"key": "whoop-reauth-pending:" + stamp.date().isoformat(),
+                               "text": ("WHOOP needs you to sign in again, data stopped %s. The login link expired. %s"
+                                        % (day, REAUTH_STEPS)), "accepted": False}
+                    state["expired_notice"] = expired
+                text = expired["text"]
+            # Persist before invoking the CLI: a crash/timeout may already have queued it.
+            state.update(pending_since=since.isoformat(), last_attempt_at=stamp.isoformat())
+            write_json(path, state, mode=0o600)
+            # Retry an expired notice with its original identity after uncertain sends.
+            key = "whoop-reauth-pending:" + stamp.date().isoformat() if pending else expired["key"]
+            accepted = notify_reauth(text, key)
+            if metrics is not None:
+                metrics["reminderSent"] = accepted
+            if accepted:
+                state["last_sent_at"] = stamp.isoformat()
+                if not pending:
+                    expired["accepted"] = True
+                write_json(path, state, mode=0o600)
+        except (OSError, ValueError, TypeError, subprocess.SubprocessError):
+            # Notification failures must not turn the quiet auth wait into sync errors.
+            pass
+
