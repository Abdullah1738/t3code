+    def reset_reauth_reminder():
+        path = os.path.join(os.path.dirname(STATUS), "reauth_reminder.json")
+        try:
+            with TokenLock():
+                state = read_json(path, {}) or {}
+                if not state:
+                    return
+                # Keep the throttle across episodes; successful sync ends this episode.
+                clean = {key: state[key] for key in ("last_attempt_at", "last_sent_at") if key in state}
+                write_json(path, clean, mode=0o600)
+        except OSError:
+            pass
+
