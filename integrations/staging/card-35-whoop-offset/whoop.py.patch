     # ------------------------------------------------------------------ helpers
+    def parse_timezone_offset(off):
+        """WHOOP fixed offsets; malformed values keep the record in UTC."""
+        if off is None or off == "" or off == "Z":
+            return timezone.utc
+        match = re.fullmatch(r"([+-])([0-9]{2})(?::?([0-9]{2}))?", off) if isinstance(off, str) else None
+        if match:
+            sign, hh, mm = match.groups()
+            hours, minutes = int(hh), int(mm or 0)
+            if hours < 24 and minutes < 60:
+                return timezone((-1 if sign == "-" else 1) * timedelta(hours=hours, minutes=minutes))
+        metrics = _sync_metrics.get()
+        if metrics is not None:
+            metrics["offsetFallbacks"] += 1
+            sample = str(off)
+            samples = metrics["offsetSamples"]
+            if sample not in samples and len(samples) < 3:
+                samples.append(sample)
+        return timezone.utc
+
