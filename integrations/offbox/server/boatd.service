[Unit]
Description=boatd: offbox server API (boat.dev-compatible) over Incus
After=network-online.target tailscaled.service zfs-mount.service zfs-import.target incus.service
Wants=network-online.target incus.service
# No Requires: without its pool or without Incus boatd serves /health and says why (degraded mode) instead of
# failing, so boot never waits for it and nobody has to restart it.

[Service]
Environment=HOME=/root
ExecStart=/usr/bin/python3 /opt/boatd/boatd.py serve
Restart=always
RestartSec=5
# Commands run in their own transient units (systemd-run), so restarting boatd never kills a run.
KillMode=process
# Every open request holds a socket and two database files. At the default 1024 about 330 clients following
# their runs made new requests fail with "Too many open files" (19 Nov 2026: 31,104 errors; 22 Nov: 140).
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
