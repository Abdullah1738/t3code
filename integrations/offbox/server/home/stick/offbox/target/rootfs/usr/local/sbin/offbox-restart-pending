#!/usr/bin/python3
"""Snapshot stale services for the next planned host release; never restart them."""
import datetime
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile


RECORD = Path("/var/lib/offbox/restart-pending.json")


def services(output):
    lines = output.splitlines()
    if not any(re.fullmatch(r"NEEDRESTART-VER:[ \t]+\S+[ \t]*", line) for line in lines):
        raise ValueError("needrestart returned no batch header")
    pending = set()
    for line in lines:
        if line.startswith("NEEDRESTART-SVC:"):
            match = re.fullmatch(r"NEEDRESTART-SVC:[ \t]+(\S+)[ \t]*", line)
            if not match:
                raise ValueError("malformed needrestart service record")
            pending.add(match[1])
    return sorted(pending)


def record(path=RECORD):
    result = subprocess.run(["/usr/sbin/needrestart", "-b", "-r", "l"],
                            capture_output=True, text=True, check=True, timeout=120)
    pending = services(result.stdout)
    payload = {"checkedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(), "services": pending}
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, prefix=".restart-pending-", delete=False) as f:
            temp = Path(f.name)
            json.dump(payload, f, sort_keys=True)
            f.write("\n")
            f.flush()
            os.fchmod(f.fileno(), 0o644)
            os.fsync(f.fileno())
        os.replace(temp, path)
    finally:
        if temp is not None:
            temp.unlink(missing_ok=True)


if __name__ == "__main__":
    record()
