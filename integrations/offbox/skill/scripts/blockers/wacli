#!/bin/zsh
# Agent-only WhatsApp send guard. Raw wacli sends are refused so agents go through `wa`, which keeps a sent
# record (and the stop/Bcc-style guards). Sending on their own is allowed; `wa draft` shows a preview where
# Abdullah's OK makes sense (27 Oct 2026: tools suggest, they don't block). wa calls wacli by absolute path,
# so only direct agent calls land here.
emulate -L zsh
setopt NO_UNSET
typeset name=${0:t} shim=${0:A} blockers=${0:A:h} real='' candidate dir a
for dir in "${path[@]}" /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
  [[ -n "$dir" ]] || dir=.
  [[ "${dir:A}" == "$blockers" ]] && continue
  candidate="$dir/$name"
  if [[ -x "$candidate" && "${candidate:A}" != "$shim" ]]; then
    real="$candidate"
    break
  fi
done

if [[ -n "${OPENCODE_SESSION_ID:-}" ]]; then
  typeset -a words value_flags=(--account --lock-wait --store --timeout)
  typeset -i i=1 for_me=0
  while (( i <= $# )); do
    a=${@[i]}
    [[ $a == -- ]] && break
    [[ $a == --for-me ]] && for_me=1
    if [[ $a == -* ]]; then
      (( ${value_flags[(Ie)$a]} )) && (( i++ ))
    elif (( ${#words} < 2 )); then
      words+=("$a")
    fi
    (( i++ ))
  done
  typeset pair="${words[1]:-} ${words[2]:-}"
  if [[ ${words[1]:-} == send || ${words[2]:-} == send || $pair == "poll vote" \
        || $pair == (messages\ forward|messages\ edit|messages\ revoke) \
        || ( $pair == "messages delete" && $for_me == 0 ) ]]; then
    print -u2 -- "Blocked: use wa for WhatsApp sends, not wacli directly (wacli $pair)."
    print -u2 -- 'Use `wa send <jid> <text>` (or `wa sendfile`): it sends right away and keeps a sent record.'
    print -u2 -- 'If Abdullah should see it first, `wa draft` prints a preview (whatsapp skill).'
    exit 2
  fi
fi
if [[ -z "$real" ]]; then
  print -u2 -- "send guard: real $name executable not found on PATH."
  exit 127
fi
exec "$real" "$@"
