{
  "version": 2,
  "doc": [
    "Offbox heavy-command classifier, owned by worker C. One rule set for the gate plugin (offbox-gate.ts), classify.py and the monitor.",
    "Splitting: a command line becomes simple commands at && || ; | |& & newline ( ) and inside $( ) / backticks. Heredoc bodies and comments are dropped.",
    "cd/pushd update the tracked cwd; NAME=value and export NAME=value set simple variables used to expand $NAME in later words.",
    "Wrappers (env, time, nice, timeout, perl -e alarm, uv run, npx, python -m, sh -c ...) are peeled; sh -c / npx --call scripts are classified recursively.",
    "Rule match: basename(argv0) matches cmd, then the first positionals match sub[] in order (flags in value_flags consume a value).",
    "After sub, positionals matching skip_re are dropped; NAME=value tokens never count as positionals; '--' is ignored.",
    "heavy = any(force_heavy_when) OR ((heavy_when absent OR any(heavy_when)) AND NOT any(local_when)). A condition is the AND of its keys:",
    "has_flag / lacks_flag (exact or --flag=value prefix), min_pos / max_pos, pos_all_re, pos_none_re, pos_any_re, cwd_re ($throwaway = throwaway_cwd_re; unknown cwd never matches), repo_file {file, re} searched upward from cwd.",
    "pkg_mentions {re, ext, go_imports}: true if a target package dir (each positional, else cwd) has a file ending in ext whose text matches re (with go_imports: or a package of the same Go module that one of its files imports does), or if a target can't be resolved to a readable dir (unknown cwd, $VAR, ..., import path). Checked last, so only after the other keys passed.",
    "Vectors: a cwd starting with $FIXTURES is resolved against scripts/tests/fixtures by both test runners.",
    "A simple command whose argv0 is offbox is never heavy. The suggested rewrite inserts 'offbox run --size S [--env NAME]... -- ' in front of the heavy argv0."
  ],
  "throwaway_cwd_re": "^(/private)?/var/folders/|^(/private)?/tmp/|/crpko-review-workflow/data/work/|/crw-wt/|/coord-wt/|/tmp/worktrees/|/crpko-devops/tmp/|/review-[^/]+|/pr-review",
  "sizes": ["small", "default", "large", "xlarge"],
  "wrappers": [
    {"cmd": "env", "value_flags": ["-u", "-S", "-C", "-P", "--unset", "--chdir"]},
    {"cmd": "time|nohup|command|exec|builtin|noglob|caffeinate|unbuffer|chronic|sudo|stdbuf|ionice", "value_flags": ["-u", "-g", "-i", "-o", "-e", "-c", "-n"]},
    {"cmd": "nice|renice", "value_flags": ["-n"]},
    {"cmd": "g?timeout", "value_flags": ["-s", "-k", "--signal", "--kill-after"], "skip_pos": 1},
    {"cmd": "perl", "value_flags": ["-e", "-E"], "skip_pos": 1},
    {"cmd": "taskpolicy", "value_flags": ["-c", "-d", "-g", "-t", "-l", "-m", "-j", "-P", "-S"]},
    {"cmd": "uv", "sub": ["run"], "value_flags": ["--with", "-w", "--python", "-p", "--project", "--directory", "--extra", "--group", "--only-group", "--env-file", "--package", "--index-url", "--with-requirements"]},
    {"cmd": "poetry|pipenv|pdm|rye|hatch", "sub": ["run"], "value_flags": []},
    {"cmd": "npx|bunx|pnpx", "value_flags": ["-p", "--package"], "script_flags": ["-c", "--call"]},
    {"cmd": "bun", "sub": ["x"], "value_flags": ["-p", "--package"]},
    {"cmd": "pnpm|yarn", "sub": ["exec|dlx"], "value_flags": ["--filter", "-F", "-C", "--dir", "-p", "--package"]},
    {"cmd": "npm", "sub": ["exec|x"], "value_flags": ["-p", "--package", "-w", "--workspace"], "script_flags": ["-c", "--call"]},
    {"cmd": "python[0-9.]*", "sub": ["-m"], "value_flags": []},
    {"cmd": "node", "node_script_re": "(?:^|/)node_modules/(?:\\.bin/|[^/]+/(?:bin/)?)?(jest|vitest|playwright|mocha|tsc|eslint)(?:\\.[cm]?js)?$"},
    {"cmd": "sh|bash|zsh|dash|ksh", "script_flags": ["-c"], "script_cluster": true}
  ],
  "rules": [
    {"id": "go-test", "class": "go-test", "size": "large", "cmd": "go", "sub": ["test"],
     "value_flags": ["-run", "-count", "-timeout", "-p", "-parallel", "-tags", "-coverprofile", "-covermode", "-coverpkg", "-o", "-overlay", "-exec", "-bench", "-benchtime", "-cpu", "-skip", "-shuffle", "-ldflags", "-gcflags", "-mod", "-C", "-vet", "-list", "-fuzz", "-fuzztime"],
     "local_when": [{"has_flag": ["-run", "-list"], "max_pos": 1, "pos_none_re": "\\.\\.\\."}],
     "force_heavy_when": [{"repo_file": {"file": "go.mod", "re": "testcontainers"}, "pkg_mentions": {"re": "testcontainers", "ext": ".go", "go_imports": true}}],
     "why": "go test across packages or without -run compiles and runs whole suites"},
    {"id": "go-build", "class": "go-build", "size": "large", "cmd": "go", "sub": ["build|vet"],
     "value_flags": ["-o", "-p", "-tags", "-ldflags", "-gcflags", "-asmflags", "-mod", "-modfile", "-C", "-overlay", "-pgo", "-buildmode", "-compiler", "-installsuffix", "-pkgdir", "-toolexec", "-vettool", "-coverpkg", "-covermode", "-exec"],
     "heavy_when": [{"cwd_re": "$throwaway", "pos_any_re": "\\.\\.\\."}, {"cwd_re": "$throwaway", "min_pos": 4}],
     "why": "go build/vet of ./... or 4+ packages in a review/worktree clone compiles most of the module"},
    {"id": "tsc-project", "class": "typecheck", "size": "default", "cmd": "tsc|vue-tsc",
     "value_flags": ["-p", "--project", "-t", "--target", "-m", "--module", "--outDir", "--outFile", "--rootDir", "--lib", "--jsx", "--moduleResolution", "--tsBuildInfoFile", "--declarationDir", "--baseUrl", "--types", "--generateTrace", "--locale"],
     "heavy_when": [{"cwd_re": "$throwaway", "pos_none_re": "\\.[cm]?[jt]sx?$", "lacks_flag": ["-w", "--watch", "-v", "--version", "-h", "--help", "--all", "--init", "--showConfig", "--listFilesOnly", "--clean"]}],
     "why": "a project-wide tsc in a review/worktree clone type-checks the whole repo"},
    {"id": "eslint-repo", "class": "lint", "size": "default", "cmd": "eslint",
     "value_flags": ["-c", "--config", "--ext", "-f", "--format", "-o", "--output-file", "--rule", "--plugin", "--parser", "--parser-options", "--resolve-plugins-relative-to", "--rulesdir", "--ignore-path", "--ignore-pattern", "--max-warnings", "--cache-location", "--cache-strategy", "--env", "--global", "--stdin-filename", "--flag", "--concurrency"],
     "heavy_when": [{"cwd_re": "$throwaway", "pos_any_re": "^\\./?$", "lacks_flag": ["--fix", "--stdin", "--print-config", "--inspect-config", "-v", "--version", "-h", "--help", "--init"]}],
     "why": "eslint . in a review/worktree clone lints the whole repo"},
    {"id": "pkg-run-check", "class": "typecheck", "size": "default", "cmd": "npm|pnpm|yarn|bun", "sub": ["run|run-script", "typecheck|type-check|typecheck:[A-Za-z0-9:_-]+|check-types|check:types|types:check|tsc|lint|lint:(all|ci|check|strict|ts|js|code|types)|eslint"],
     "value_flags": ["--prefix", "-C", "--dir", "--filter", "-F", "-w", "--workspace", "-f", "--format", "-o", "--output-file", "--max-warnings", "-p", "--project"],
     "heavy_when": [{"cwd_re": "$throwaway", "lacks_flag": ["--fix", "--watch"]}],
     "local_when": [{"min_pos": 1, "pos_all_re": "\\.[cm]?[jt]sx?$|\\.vue$"}],
     "why": "a repo-wide typecheck/lint script in a review/worktree clone checks the whole repo"},
    {"id": "pkg-check-bare", "class": "typecheck", "size": "default", "cmd": "pnpm|yarn|bun", "sub": ["typecheck|type-check|typecheck:[A-Za-z0-9:_-]+|check-types|check:types|types:check|tsc|lint|lint:(all|ci|check|strict|ts|js|code|types)|eslint"],
     "value_flags": ["-C", "--dir", "--filter", "-F", "-w", "--workspace", "--cwd", "-f", "--format", "-o", "--output-file", "--max-warnings", "-p", "--project"],
     "heavy_when": [{"cwd_re": "$throwaway", "lacks_flag": ["--fix", "--watch"]}],
     "local_when": [{"min_pos": 1, "pos_all_re": "\\.[cm]?[jt]sx?$|\\.vue$"}],
     "why": "a repo-wide typecheck/lint script in a review/worktree clone checks the whole repo"},
    {"id": "pytest", "class": "pytest", "size": "large", "cmd": "pytest|py\\.test",
     "value_flags": ["-k", "-m", "-n", "-p", "-o", "-c", "-W", "-r", "--tb", "--rootdir", "--basetemp", "--maxfail", "--junitxml", "--junit-xml", "--cov", "--cov-report", "--durations", "--ignore", "--deselect", "--confcutdir", "--log-level", "--timeout", "--dist", "--numprocesses", "--import-mode", "--count"],
     "local_when": [{"lacks_flag": ["-n", "--numprocesses", "--dist"], "min_pos": 1, "max_pos": 3, "pos_all_re": "(\\.py$|\\.py::|::)"}],
     "why": "pytest over a whole dir, or with -n workers, runs the full suite"},
    {"id": "js-test", "class": "js-test", "size": "large", "cmd": "jest|vitest|mocha", "skip_re": "^(run|watch|related)$",
     "value_flags": ["-t", "--testNamePattern", "-c", "--config", "--project", "--maxWorkers", "-w", "--reporter", "--reporters", "--testTimeout", "--outputFile", "--shard", "--env", "--environment", "--pool", "--root", "--dir", "--testPathPattern", "--testPathIgnorePatterns", "--selectProjects", "--coverageProvider"],
     "local_when": [{"min_pos": 1, "max_pos": 3, "pos_all_re": "\\.[cm]?[jt]sx?$|/__tests__/"}],
     "why": "jest/vitest without a single test file runs the whole suite"},
    {"id": "vp-test", "class": "js-test", "size": "large", "cmd": "vp|playwright", "sub": ["test"], "skip_re": "^(run|watch)$",
     "value_flags": ["-t", "--project", "-c", "--config", "--reporter", "--workers", "-j", "--grep", "-g", "--shard"],
     "local_when": [{"min_pos": 1, "max_pos": 3, "pos_all_re": "\\.[cm]?[jt]sx?$"}],
     "why": "vp/playwright test without a single file runs the whole suite"},
    {"id": "bun-test", "class": "js-test", "size": "default", "cmd": "bun", "sub": ["test"],
     "value_flags": ["-t", "--test-name-pattern", "--timeout", "--preload", "--rerun-each", "--coverage-reporter"],
     "local_when": [{"min_pos": 1, "max_pos": 3, "pos_all_re": "\\.[cm]?[jt]sx?$"}],
     "why": "bun test without a file runs the whole suite"},
    {"id": "pkg-test", "class": "js-test", "size": "large", "cmd": "npm|pnpm|yarn", "sub": ["test|t|tst|test:(all|ci|unit|run|full|e2e|integration|coverage|cov|race)"],
     "value_flags": ["--prefix", "-C", "--dir", "--filter", "-F", "-w", "--workspace", "--maxWorkers", "-t", "--reporter", "--reporters"],
     "local_when": [{"min_pos": 1, "max_pos": 3, "pos_all_re": "\\.[cm]?[jt]sx?$|\\.py(::.*)?$"}],
     "why": "the package test script runs the whole suite"},
    {"id": "pkg-run-test", "class": "js-test", "size": "large", "cmd": "npm|pnpm|yarn|bun", "sub": ["run|run-script", "test|tests|test:(all|ci|unit|run|full|e2e|integration|coverage|cov|race)|e2e|test-all"],
     "value_flags": ["--prefix", "-C", "--dir", "--filter", "-F", "-w", "--workspace", "--maxWorkers", "-t", "--reporter", "--reporters"],
     "local_when": [{"min_pos": 1, "max_pos": 3, "pos_all_re": "\\.[cm]?[jt]sx?$|\\.py(::.*)?$"}],
     "why": "the package test script runs the whole suite"},
    {"id": "pkg-install", "class": "install", "size": "default", "cmd": "npm|pnpm|yarn|bun", "sub": ["ci|install|i"],
     "value_flags": ["--registry", "--cache", "--prefix", "-C", "--dir", "--filter", "-F", "--network-concurrency", "--omit", "--include"],
     "heavy_when": [{"cwd_re": "$throwaway", "max_pos": 0, "lacks_flag": ["-g", "--global", "--help", "-h"]}],
     "why": "full dependency installs in throwaway review clones belong on a box"},
    {"id": "yarn-bare", "class": "install", "size": "default", "cmd": "yarn",
     "value_flags": ["--cwd"],
     "heavy_when": [{"cwd_re": "$throwaway", "max_pos": 0, "lacks_flag": ["--help", "-h", "--version", "-v"]}],
     "why": "bare yarn is a full install"},
    {"id": "docker-run", "class": "docker", "size": "default", "cmd": "docker|podman", "sub": ["run|create|start"],
     "value_flags": ["--context", "-c", "-H", "--host", "--config", "-l", "--log-level"],
     "why": "local containers load the Mac; run them on a box"},
    {"id": "docker-container-run", "class": "docker", "size": "default", "cmd": "docker|podman", "sub": ["container", "run|create|start"],
     "value_flags": ["--context", "-c", "-H", "--host", "--config", "-l", "--log-level"],
     "why": "local containers load the Mac; run them on a box"},
    {"id": "docker-build", "class": "docker", "size": "large", "cmd": "docker|podman", "sub": ["build"],
     "value_flags": ["--context", "-c", "-H", "--host", "--config", "-l", "--log-level"],
     "why": "image builds are CPU and disk heavy"},
    {"id": "docker-buildx-build", "class": "docker", "size": "large", "cmd": "docker", "sub": ["buildx|image|builder", "build|b|bake"],
     "value_flags": ["--context", "-c", "-H", "--host", "--config", "-l", "--log-level", "--builder"],
     "why": "image builds are CPU and disk heavy"},
    {"id": "docker-compose-up", "class": "docker", "size": "xlarge", "cmd": "docker|podman", "sub": ["compose", "up|run|create|start|restart|build"],
     "value_flags": ["--context", "-c", "-H", "--host", "--config", "-l", "--log-level", "-f", "--file", "-p", "--project-name", "--profile", "--env-file", "--project-directory", "--ansi", "--progress", "--parallel"],
     "why": "compose stacks (the Crpko harness) need 12-16 GB; use an xlarge box"},
    {"id": "docker-compose-v1", "class": "docker", "size": "xlarge", "cmd": "docker-compose|podman-compose", "sub": ["up|run|create|start|restart|build"],
     "value_flags": ["-f", "--file", "-p", "--project-name", "--profile", "--env-file", "--project-directory"],
     "why": "compose stacks (the Crpko harness) need 12-16 GB; use an xlarge box"},
    {"id": "gradle", "class": "gradle", "size": "large", "cmd": "gradlew|gradle",
     "value_flags": ["-p", "--project-dir", "-x", "--exclude-task", "-D", "-P", "--init-script", "-I"],
     "local_when": [{"has_flag": ["--stop", "--status", "--version", "-v", "--help", "-h"]}, {"min_pos": 1, "pos_all_re": "^(tasks|help|properties|projects|dependencies)$"}],
     "why": "gradle builds and tests use every core"},
    {"id": "cargo", "class": "cargo", "size": "large", "cmd": "cargo", "sub": ["build|b|test|t|nextest|bench"],
     "why": "cargo build/test compiles the whole workspace"},
    {"id": "make-test", "class": "make-test", "size": "large", "cmd": "make|gmake",
     "value_flags": ["-C", "-f", "-j", "--directory", "--file", "-I", "-l", "-o", "-W"],
     "heavy_when": [{"pos_any_re": "^(test|tests|check|ci|e2e|integration|race|coverage|cov|acceptance|harness)([-_:.][A-Za-z0-9_.:-]*)?$"}],
     "why": "make test/check targets run whole suites"},
    {"id": "forge-test", "class": "evm", "size": "default", "cmd": "forge", "sub": ["test|t|coverage|snapshot"],
     "why": "forge test compiles and fuzzes the whole project"},
    {"id": "anvil", "class": "evm", "size": "default", "cmd": "anvil",
     "local_when": [{"has_flag": ["--version", "-V", "--help", "-h"]}],
     "why": "anvil (esp. forked) runs a local chain"}
  ],
