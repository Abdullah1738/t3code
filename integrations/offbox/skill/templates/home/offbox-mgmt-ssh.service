[Unit]
Description=Offbox management SSH
After=network.target

[Service]
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/offbox_mgmt_sshd_config
ExecStart=/usr/sbin/sshd -D -f /etc/ssh/offbox_mgmt_sshd_config
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
