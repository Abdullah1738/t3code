#!/usr/bin/python3
"""qcard: quick chat cards (page + 1200x630 og preview) in a couple of seconds.

usage:
  qcard price ASSET [--range 1D|1W|1M|1Y|5Y]        live price card (gold, silver, btc, eth, AAPL, EURUSD, oil, sp500...)
  qcard spec FILE.json|-                              any template from a JSON spec
  qcard stat|compare|list|timeline|breakdown --json '{...}'   same, inline JSON (template from the verb)
  qcard templates                                     print a sample spec for every template
  qcard clean [--days 14]                             remove old q-* card dirs

common options:
  --name NAME          slug part (default from title)      --out DIR   write somewhere else (no publish)
  --send owner|moni|CHAT   publish/share and, with --session, send to CHAT (remote chats get a link relay)
  --session ID --key K     caller's bridge session + dedupe key (default qcard:SLUG:CHAT)
  --caption/--subcaption/--summary   override card text (no times/dates/day words; the bridge strips them)
  --no-og              skip the preview image (faster, for local checks)
Prints JSON: {dir, page, og, slug, url?, caption, subcaption, title, description, ms}.
"""
import threading
import argparse, glob, json, os, re, shlex, shutil, sqlite3, subprocess, sys, tempfile, time
from pathlib import Path

LIB = os.path.expanduser("~/.local/libexec/qcard")
sys.path.insert(0, LIB)
import render  # noqa: E402

APPS = os.path.expanduser("~/.local/share/imessage-apps")
CHROME = os.environ.get("CHROME_PATH")
BUN = "/Users/ardud/.bun/bin/bun"
BRIDGE = os.path.expanduser("~/.local/share/spectrum-bridge/src/cli.ts")
try:
    source = Path(__file__).resolve().parents[1] / "libexec/toollog"
    sys.path.insert(0, str(source if source.is_dir() else Path.home() / ".local/libexec/toollog"))
    from toollog import emit
except ImportError:
    def emit(*_args, **_kwargs):
        pass
TEMPLATES = ["price", "stat", "compare", "list", "timeline", "breakdown"]
TIMEWORDS = re.compile(r"\b(today|tonight|tomorrow|yesterday|now|mon|tue|wed|thu|fri|sat|sun)[a-z]*\b|\d{1,2}:\d{2}|\b\d{1,2}\s?(am|pm)\b", re.I)


def bridge_cmd():
    return shlex.split(os.environ["QCARD_BRIDGE"]) if os.environ.get("QCARD_BRIDGE") else [BUN, BRIDGE]


def log_event(name, *, command, who=None, ack=None, exit_code=None):
    emit("qcard", "error" if name == "bridge.error" else "event", name, board="imessage",
         ok=name != "bridge.error", ids={"sampleId": ack},
         props={"command": command, "route": who, "exitCode": exit_code},
         error_tag="bridge.request_failed" if name == "bridge.error" else None)


def log_render(started, ok, *, chat=None, outcome=None, failure_code=None):
    try:
        chat = chat if chat in ('owner', 'moni') else 'other' if chat else 'unknown'
        outcome = outcome if outcome in ('ok', 'fallback', 'failed') else 'ok' if ok else 'failed'
        failure_code = failure_code if failure_code in ('none', 'preview_missing', 'render_exception') else 'none' if ok else 'renderer_failed'
        env = {k: v for k, v in os.environ.items() if k != 'BUN_INSPECT'}
        child = subprocess.Popen([*bridge_cmd(), 'log-card-render', '--kind', 'quick',
                                  '--ms', str(max(0, (time.monotonic() - started) * 1000)), '--chat', chat, '--outcome', outcome, '--failure-code', failure_code, '--attempt', '1', '--ok', str(ok).lower()],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env)
        # Reap without holding the renderer or its per-order lock for logging.
        threading.Thread(target=child.wait, daemon=True).start()
    except Exception:
        pass


def slugify(s):
    return re.sub(r"[^a-z0-9]+", "-", str(s).lower()).strip("-")[:28] or "card"


def chrome():
    if os.environ.get("CHROME_PATH"):
        return os.environ["CHROME_PATH"]
    pattern = os.path.expanduser("~/.robob/tools/chrome-headless-shell/mac-arm64/*/chrome-headless-shell")
    candidates = []
    for path in glob.glob(pattern):
        version = os.path.basename(os.path.dirname(path)).split(".")
        if all(part.isdigit() for part in version) and os.path.isfile(path) and os.access(path, os.X_OK):
            candidates.append((tuple(int(part) for part in version), path))
    if candidates:
        return max(candidates)[1]
    try:
        result = subprocess.run([os.path.expanduser("~/.local/bin/taste"), "chrome"],
                                capture_output=True, text=True, timeout=10)
        path = result.stdout.strip()
        safe = all("ms-playwright" not in p.split(os.sep) for p in (path, os.path.realpath(path)))
        if result.returncode == 0 and safe and os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    except (OSError, subprocess.TimeoutExpired):
        pass
    raise FileNotFoundError("qcard: no chrome-headless-shell (Robob's ~/.robob/tools/chrome-headless-shell); see taste chrome")


def shot(html_path, png, w, h, budget=250):
    global CHROME
    if not CHROME:
        CHROME = chrome()
    with tempfile.TemporaryDirectory() as prof:
        subprocess.run([CHROME, "--headless", "--disable-gpu", "--hide-scrollbars", "--no-first-run", f"--user-data-dir={prof}",
                        "--force-device-scale-factor=1", f"--virtual-time-budget={budget}", f"--window-size={w},{h}",
                        f"--screenshot={png}", "file://" + html_path], check=True, capture_output=True, timeout=30)


class BridgeError(SystemExit):
    def __init__(self, command, error):
        super().__init__(f"qcard: bridge {command} failed: {error}")
        self.remote_chat = bool(re.search(r"\(HTTP 403\)", error)
                                and "Use agent-ask to reach this chat on its box" in error)


def bridge(*args):
    env = {k: v for k, v in os.environ.items() if k != "BUN_INSPECT"}
    try:
        r = subprocess.run([*bridge_cmd(), *args], capture_output=True, text=True, env=env,
                           stdin=subprocess.DEVNULL, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as ex:
        log_event("bridge.error", command=args[0])
        raise BridgeError(args[0], str(ex)) from ex
    if r.returncode:
        log_event("bridge.error", command=args[0], exit_code=r.returncode)
        raise BridgeError(args[0], r.stderr.strip() or r.stdout.strip())
    try:
        data = json.loads(r.stdout.strip().splitlines()[-1])
        if not isinstance(data, dict):
            raise ValueError("expected an object")
        return data
    except (ValueError, IndexError) as ex:
        log_event("bridge.error", command=args[0], exit_code=r.returncode)
        raise BridgeError(args[0], f"invalid JSON response: {r.stdout.strip()} {r.stderr.strip()}") from ex


def bridge_state():
    return Path(os.environ.get("QCARD_BRIDGE_STATE") or Path.home() / ".config/spectrum-bridge")


def own_chat(to, session):
    # Cross-chat --to is owner-only; a chat's own live session must reply without it.
    db = bridge_state() / ("state.sqlite" if to in ("owner", "abdullah") else f"chats/{to}/state.sqlite")
    if not db.is_file():
        return False
    try:
        con = sqlite3.connect(f"{db.absolute().as_uri()}?mode=ro", uri=True, timeout=5)
        try:
            row = con.execute("select value from kv where key = 'route'").fetchone()
        finally:
            con.close()
        route = json.loads(row[0]) if row and row[0] else None
    except (OSError, ValueError, sqlite3.Error):
        return False
    if not isinstance(route, dict) or not isinstance(route.get("id"), str):
        return False
    g = route.get("generation")
    if type(g) is not int or g < 0:
        return False
    return session in (route["id"], f"{route['id']}@{g}")


def remote_chat(who):
    try:
        config = json.loads((bridge_state() / "config.json").read_text())
        return who not in ("owner", "abdullah") and config["chatBackends"][who]["kind"] == "remote-box"
    except (OSError, ValueError, KeyError, TypeError):
        return False


def relay(who, session, key, text):
    request = ("Send this quick card link once in your own chat, using bridge send with dedupe key "
               + json.dumps(key) + ". Keep that same key on any retry; reconcile an ambiguous send. "
               "The exact message is the JSON string below. Answer done only after bridge acceptance; "
               "otherwise answer declined with the send error.\n" + json.dumps(text))
    ack = bridge("agent-ask", "--to", who, "--text=" + request, "--session", session, "--key", key)
    if not isinstance(ack.get("id"), str) or not ack["id"] or type(ack.get("created")) is not bool:
        log_event("bridge.error", command="agent-ask", who=who)
        raise BridgeError("agent-ask", "bad ack")
    log_event("relay", command="agent-ask", who=who, ack=ack["id"])
    return {"relayed": True, "status": "relayed", "ack": ack["id"], "created": ack["created"], "to": who, "key": key}


def clean(days=14):
    cut, gone = time.time() - days * 86400, []
    if not os.path.isdir(APPS):
        return gone
    # Any card the bridge still lists as shared stays, live or not: a share that is down during a restart keeps its
    # permanent link, and its files must survive so the link recovers. If the list can't be read, delete nothing.
    try:
        shared = {s["app"] for s in bridge("shares").get("shares", [])}
    except SystemExit:
        return gone
    for d in os.listdir(APPS):
        p = os.path.join(APPS, d)
        if d in shared:
            continue
        if d.startswith("q-") and os.path.isdir(p) and os.path.getmtime(p) < cut:
            shutil.rmtree(p, ignore_errors=True)
            gone.append(d)
    return gone


def card_text(s):
    return TIMEWORDS.sub("", s or "").replace("  ", " ").strip(" ·-")


SAMPLES = {
    "stat": {"template": "stat", "title": "Body weight", "sub": "Scale, 7-day average", "value": 81.4, "unit": "kg", "decimals": 1,
             "change": -1.2, "change_note": "vs last month", "points": [83.1, 82.9, 82.6, 82.7, 82.2, 81.9, 81.8, 81.4],
             "stats": [{"label": "Lowest", "value": "81.1 kg"}, {"label": "Goal", "value": "78 kg"}], "accent": "#2f6fdb"},
    "compare": {"template": "compare", "title": "Flights to London", "sub": "DXB to LHR, one adult", "best_by": "Price", "best_dir": "min",
                "fields": ["Price", "Time", "Stops"],
                "options": [{"name": "Emirates", "values": {"Price": "AED 2,890", "Time": "7h 40m", "Stops": "Direct"}, "note": "A380, lounge access"},
                            {"name": "BA", "values": {"Price": "AED 2,640", "Time": "7h 55m", "Stops": "Direct"}},
                            {"name": "Turkish", "values": {"Price": "AED 2,150", "Time": "11h 20m", "Stops": "1 stop"}, "note": "IST layover 2h"}]},
    "list": {"template": "list", "title": "Trip packing", "items": [{"text": "Passports", "done": True}, {"text": "Dog passports", "done": True},
             {"text": "Chargers"}, {"text": "Gym kit", "note": "Lifting belt"}, {"text": "Meds box", "value": "8 days"}], "accent": "#2e9e6a"},
    "timeline": {"template": "timeline", "title": "Visa renewal", "sub": "UAE residence",
                 "events": [{"when": "1 Oct", "text": "Medical test", "state": "done"}, {"when": "8 Oct", "text": "Emirates ID biometrics", "state": "done"},
                            {"when": "This week", "text": "Visa stamping", "state": "now", "note": "Waiting on GDRFA"},
                            {"when": "Next", "text": "Collect Emirates ID"}], "accent": "#d9534f"},
    "breakdown": {"template": "breakdown", "title": "October spend", "currency": "AED", "kind": "donut",
                  "items": [{"label": "Rent", "value": 9500}, {"label": "Food", "value": 3200}, {"label": "Rides", "value": 1450},
                            {"label": "Gym", "value": 900}, {"label": "Other", "value": 1100}]},
}


def main():
    ap = argparse.ArgumentParser(prog="qcard", add_help=False)
    ap.add_argument("cmd")
    ap.add_argument("arg", nargs="?")
    ap.add_argument("--range", default="1M")
    ap.add_argument("--json")
    ap.add_argument("--name")
    ap.add_argument("--out")
    ap.add_argument("--send")
    ap.add_argument("--session")
    ap.add_argument("--key")
    ap.add_argument("--caption")
    ap.add_argument("--subcaption")
    ap.add_argument("--summary")
    ap.add_argument("--days", type=int, default=14)
    ap.add_argument("--no-og", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    a = ap.parse_args()
    if a.send and not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,99}", a.send):
        raise SystemExit("qcard: --send must be a bridge chat slug")
    t0 = time.time()

    if a.cmd == "templates":
        print(json.dumps(SAMPLES, indent=2))
        return
    if a.cmd == "clean":
        print(json.dumps({"removed": clean(a.days)}))
        return
    if a.cmd == "price":
        import data
        if not a.arg:
            raise SystemExit("qcard price ASSET")
        spec = data.price_spec(a.arg, a.range)
    elif a.cmd == "spec":
        src = sys.stdin.read() if a.arg in (None, "-") else open(a.arg).read()
        spec = json.loads(src)
    elif a.cmd in TEMPLATES:
        if not a.json and not a.arg:
            raise SystemExit(f"qcard {a.cmd} --json '{{...}}'  (see qcard templates)")
        spec = json.loads(a.json or (sys.stdin.read() if a.arg == "-" else open(a.arg).read()))
        spec.setdefault("template", a.cmd)
    else:
        raise SystemExit(__doc__)
    if spec.get("template") not in TEMPLATES:
        raise SystemExit(f"qcard: template must be one of {TEMPLATES}")
    t_data = time.time()

    render_started = time.monotonic()
    render_ok = False
    try:
        built = time.time()
        page, og, meta = render.build(spec, built)
        name = slugify(a.name or spec.get("name") or spec.get("title"))
        slug = f"q-{name}-{int(built)}"[:64]
        out = os.path.abspath(a.out) if a.out else os.path.join(APPS, slug)
        os.makedirs(out, exist_ok=True)
        open(os.path.join(out, "index.html"), "w").write(page)
        open(os.path.join(out, "spec.json"), "w").write(json.dumps(spec, default=str))
        og_png = os.path.join(out, "og.png")
        if not a.no_og:
            og_html = os.path.join(out, ".og.html")
            open(og_html, "w").write(og)
            shot(og_html, og_png + ".tmp.png", 1200, 630)
            os.replace(og_png + ".tmp.png", og_png)
            os.unlink(og_html)
        render_ok = True
    finally:
        try:
            log_render(render_started, render_ok, chat=a.send,
                       failure_code='none' if render_ok else 'render_exception')
        except Exception:
            pass
    caption = card_text(a.caption or meta["caption"])
    sub = card_text(a.subcaption or meta["subcaption"])
    res = dict(dir=out, page=os.path.join(out, "index.html"), og=og_png if not a.no_og else None, slug=slug,
               title=meta["title"], description=meta["description"], caption=caption, subcaption=sub)

    if a.send:
        if a.out:
            raise SystemExit("qcard: --send needs the default imessage-apps dir (drop --out)")
        if a.send == "owner":
            pub = bridge("publish", "--app", slug)
            url = pub["url"]
            if pub.get("metadataWarnings"):
                res["metadataWarnings"] = pub["metadataWarnings"]
        else:
            sh = bridge("share", "--app", slug, "--days", "7")
            url = sh.get("url") or sh.get("publicUrl") or next((v for v in sh.values() if isinstance(v, str) and v.startswith("https://")), None)
            if not url:
                raise SystemExit(f"qcard: share gave no url: {sh}")
        url = url + ("" if url.endswith("/") else "/") + f"?v={int(built)}"
        res["url"] = url
        if a.session:
            key = a.key or f"qcard:{slug}:{a.send}"
            own = own_chat(a.send, a.session)
            use_relay = not own and remote_chat(a.send)
            args = ["app", "--url", url, "--caption", caption, "--session", a.session, "--key", key]
            if not own:
                args += ["--to", a.send]
            if sub:
                args += ["--subcaption", sub]
            if a.summary:
                args += ["--summary", card_text(a.summary)]
            if not use_relay:
                try:
                    res["sent"] = bridge(*args)
                except BridgeError as ex:
                    if own or not ex.remote_chat or a.send in ("owner", "abdullah"):
                        raise
                    use_relay = True
            if use_relay:
                res["sent"] = relay(a.send, a.session, key, f"{caption}: {url}")
    res["ms"] = {"data": int((t_data - t0) * 1000), "total": int((time.time() - t0) * 1000)}
    print(json.dumps(res, indent=1))
    if not a.out and a.cmd != "clean":
        try:
            clean(a.days)
        except Exception:
            pass


if __name__ == "__main__":
    main()
