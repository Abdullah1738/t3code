#!/usr/bin/python3
"""Give a local service a friendly https://<name>.tail address on the tailnet.

    tailname add <name> <port> [--path /sub] [--note "what it is"]   proxy https://<name>.tail[/sub] to 127.0.0.1:<port>
    tailname add <name> --dir <folder> [--note ...]                   serve a folder of static files
    tailname rm <name> [--path /sub]
    tailname list [--json]
    tailname check [<name>]                                           resolve + fetch through the gateway
    tailname render                                                   rewrite the Caddyfile from routes.json and reload

Routes live in ~/.config/tail-gateway/routes.json (the only state). The Caddyfile is generated from it.
Every name resolves (wildcard DNS), but only names listed here get a certificate and a backend.
"""
import fcntl
import json
import os
import re
import socket
import ssl
import subprocess
import sys
import tempfile
import urllib.request

HOME = os.path.expanduser("~")
CONF_DIR = os.environ.get("TAIL_GATEWAY_CONFIG", os.path.join(HOME, ".config/tail-gateway"))
ROUTES = os.path.join(CONF_DIR, "routes.json")
LIVE = os.environ.get("TAIL_GATEWAY_HOME", os.path.join(HOME, ".local/share/tail-gateway"))
CADDYFILE = os.path.join(LIVE, "Caddyfile")
CA_CERT = os.path.join(LIVE, "ca/root.crt")
CADDY = os.environ.get("CADDY_BIN", "/opt/homebrew/bin/caddy")
GATEWAY_IP = os.environ.get("TAIL_GATEWAY_IP", "")
# Unix socket, not TCP: the userspace gateway node forwards tailnet traffic to this Mac's 127.0.0.1 ports.
ADMIN = "unix/" + os.path.join(LIVE, "caddy-admin.sock")

NAME_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")
PATH_RE = re.compile(r"^(/(?!\.\.?(/|$))[A-Za-z0-9._~-]+)+$")
# Names other things already mean. "gateway" is the gateway's own landing page.
RESERVED = {"gateway", "ca", "localhost", "www", "wpad", "isatap"}


def die(msg, code=1):
    print(f"tailname: {msg}", file=sys.stderr)
    sys.exit(code)


def load():
    try:
        with open(ROUTES) as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {"routes": []}
    data.setdefault("routes", [])
    return data


def save(data):
    os.makedirs(CONF_DIR, exist_ok=True)
    data["routes"].sort(key=lambda r: (r["name"], -len(r.get("path", "")), r.get("path", "")))
    fd, tmp = tempfile.mkstemp(dir=CONF_DIR, prefix=".routes.")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    os.replace(tmp, ROUTES)


def caddy_quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def render(data):
    """Caddyfile text for the routes. Pure function: tested without Caddy."""
    out = [
        "# Generated by tailname from ~/.config/tail-gateway/routes.json. Don't edit; run `tailname render`.",
        "{",
        f"\tadmin {ADMIN}",
        f"\tstorage file_system {LIVE}/caddy-data",
        "\thttp_port 7080",
        "\thttps_port 7443",
        "\tdefault_bind 127.0.0.1",
        "\tskip_install_trust",
        "\tpki {",
        "\t\tca tail {",
        '\t\t\tname "Abdullah Tailnet .tail CA"',
        "\t\t\troot {",
        f"\t\t\t\tcert {LIVE}/ca/root.crt",
        f"\t\t\t\tkey {LIVE}/ca/root.key",
        "\t\t\t}",
        "\t\t}",
        "\t}",
        "}",
        "",
        "(tailtls) {",
        "\ttls {",
        "\t\tissuer internal {",
        "\t\t\tca tail",
        "\t\t}",
        "\t}",
        "}",
        "",
        "# Plain http on :80 of every .tail name goes to https.",
        "http://*.tail {",
        "\tredir https://{host}{uri} 308",
        "}",
        "",
        "# The profile with a publicly trusted cert, for a device that doesn't trust the CA yet: the node's",
        "# `tailscale serve --https=8443` (real ts.net cert) forwards here. Profile and cert only.",
        "http://tail-gateway.tailcca332.ts.net:7080 {",
        "\t@ca path /ca.crt /tail-ca.mobileconfig",
        "\thandle @ca {",
        "\t\theader /ca.crt Content-Type application/x-x509-ca-cert",
        "\t\theader /tail-ca.mobileconfig Content-Type application/x-apple-aspen-config",
        f"\t\troot * {LIVE}/www",
        "\t\tfile_server",
        "\t}",
        "\thandle {",
        "\t\tredir * /tail-ca.mobileconfig 302",
        "\t}",
        "}",
        "",
        "# Plain-http fallback by .tail name (only safe while the device uses tailnet DNS; prefer the ts.net link).",
        "http://gateway.tail {",
        "\t@ca path /ca.crt /tail-ca.mobileconfig",
        "\thandle @ca {",
        "\t\theader /ca.crt Content-Type application/x-x509-ca-cert",
        "\t\theader /tail-ca.mobileconfig Content-Type application/x-apple-aspen-config",
        f"\t\troot * {LIVE}/www",
        "\t\tfile_server",
        "\t}",
        "\thandle {",
        "\t\tredir * /tail-ca.mobileconfig 302",
        "\t}",
        "}",
        "",
        "gateway.tail {",
        "\timport tailtls",
        "\theader Cache-Control no-store",
        "\thandle /ca.crt {",
        "\t\theader Content-Type application/x-x509-ca-cert",
        f"\t\troot * {LIVE}/www",
        "\t\tfile_server",
        "\t}",
        "\thandle /tail-ca.mobileconfig {",
        "\t\theader Content-Type application/x-apple-aspen-config",
        f"\t\troot * {LIVE}/www",
        "\t\tfile_server",
        "\t}",
        "\thandle {",
        f"\t\troot * {LIVE}/www",
        "\t\ttry_files {path} /index.html",
        "\t\tfile_server",
        "\t}",
        "}",
    ]
    by_name = {}
    for r in data["routes"]:
        by_name.setdefault(r["name"], []).append(r)
    for name in sorted(by_name):
        routes = sorted(by_name[name], key=lambda r: -len(r.get("path", "")))
        out += ["", f"{name}.tail {{", "\timport tailtls"]
        for r in routes:
            path = r.get("path", "")
            if path:
                # /robob and /robob/... both go to the backend with the prefix stripped.
                out += [f"\tredir {path} {path}/{{?query}} 308", f"\thandle_path {path}/* {{"]
            else:
                out.append("\thandle {")
            if r.get("dir"):
                out += [f"\t\troot * {caddy_quote(r['dir'])}", "\t\tfile_server browse {", "\t\t\thide .*", "\t\t}"]
            else:
                out.append(f"\t\treverse_proxy 127.0.0.1:{int(r['port'])}")
            out.append("\t}")
        if all(r.get("path") for r in routes):
            out += ["\thandle {", "\t\trespond 404", "\t}"]
        out.append("}")
    return "\n".join(out) + "\n"


def write_and_reload(data):
    """Render, validate and install the Caddyfile, then reload Caddy. Raises SystemExit before touching
    anything if the new config is invalid."""
    text = render(data)
    os.makedirs(LIVE, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=LIVE, prefix=".Caddyfile.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    v = subprocess.run([CADDY, "validate", "--config", tmp, "--adapter", "caddyfile"], capture_output=True, text=True)
    if v.returncode != 0:
        os.unlink(tmp)
        die("the new config is invalid, nothing changed:\n" + (v.stderr or v.stdout)[-2000:])
    os.replace(tmp, CADDYFILE)
    site = os.path.join(os.path.dirname(os.path.realpath(__file__)), "tail-gateway-site")
    if os.path.exists(site) and os.path.exists(CA_CERT):
        subprocess.run([site], capture_output=True)  # refresh the gateway.tail index; best effort
    if not os.path.exists(ADMIN.removeprefix("unix/")):
        print("tailname: saved; Caddy isn't running (launchd starts it with this file)", file=sys.stderr)
        return
    r = subprocess.run([CADDY, "reload", "--config", CADDYFILE, "--adapter", "caddyfile", "--address", ADMIN],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die("saved, but Caddy refused the reload (still serving the old config):\n"
            + (r.stderr or r.stdout).strip()[-1500:])


class locked:
    """One tailname edit at a time: parallel agents would otherwise lose each other's routes."""

    def __enter__(self):
        os.makedirs(CONF_DIR, exist_ok=True)
        self.f = open(os.path.join(CONF_DIR, ".lock"), "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def commit(data):
    """Install the config for `data` first; only save routes.json once Caddy accepted it."""
    write_and_reload(data)
    save(data)


def port_listening(port):
    with socket.socket() as s:
        s.settimeout(1)
        return s.connect_ex(("127.0.0.1", port)) == 0


def parse_opts(args, flags):
    opts, rest = {}, []
    it = iter(args)
    for a in it:
        if a in flags:
            try:
                opts[a] = next(it)
            except StopIteration:
                die(f"{a} needs a value", 2)
        else:
            rest.append(a)
    return opts, rest


def cmd_add(args):
    opts, rest = parse_opts(args, {"--path", "--note", "--dir"})
    if not rest:
        die("usage: tailname add <name> <port> [--path /sub] [--note ...] | add <name> --dir <folder>", 2)
    name = rest[0].lower().removesuffix(".tail")
    if not NAME_RE.match(name):
        die(f"bad name {name!r}: lowercase letters, digits and dashes", 2)
    if name in RESERVED:
        die(f"{name!r} is reserved", 2)
    path = opts.get("--path", "").rstrip("/")
    if path and not PATH_RE.match(path):
        die(f"bad path {path!r}: like /robob", 2)
    route = {"name": name}
    if path:
        route["path"] = path
    if "--dir" in opts:
        d = os.path.realpath(os.path.expanduser(opts["--dir"]))
        if not os.path.isdir(d):
            die(f"{d} is not a folder", 2)
        if re.search(r"[{}\x00-\x1f\"\\]", d) or d in ("/", HOME) or not d.startswith("/"):
            die(f"refusing to serve {d!r}", 2)
        route["dir"] = d
        if len(rest) > 1:
            die("give a port or --dir, not both", 2)
    else:
        if len(rest) != 2 or not rest[1].isdigit() or not (1 <= int(rest[1]) <= 65535):
            die("need a local port (the service on 127.0.0.1)", 2)
        route["port"] = int(rest[1])
        if not port_listening(route["port"]):
            print(f"tailname: note: nothing is listening on 127.0.0.1:{route['port']} right now", file=sys.stderr)
    if "--note" in opts:
        route["note"] = opts["--note"]
    with locked():
        data = load()
        data["routes"] = [r for r in data["routes"] if not (r["name"] == name and r.get("path", "") == path)]
        data["routes"].append(route)
        commit(data)
    print(f"https://{name}.tail{path}/" if path else f"https://{name}.tail")


def cmd_rm(args):
    opts, rest = parse_opts(args, {"--path"})
    if len(rest) != 1:
        die("usage: tailname rm <name> [--path /sub]", 2)
    name = rest[0].lower().removesuffix(".tail")
    path = opts.get("--path", "").rstrip("/")
    with locked():
        data = load()
        before = len(data["routes"])
        data["routes"] = [r for r in data["routes"] if not (r["name"] == name and r.get("path", "") == path)]
        if len(data["routes"]) == before:
            die(f"no route {name}.tail{path}")
        commit(data)
    print(f"removed {name}.tail{path}")


def cmd_list(args):
    data = load()
    if "--json" in args:
        print(json.dumps(data["routes"], indent=2))
        return
    for r in data["routes"]:
        url = f"https://{r['name']}.tail{r.get('path', '')}"
        target = r.get("dir") or f"127.0.0.1:{r['port']}"
        print(f"{url:42} -> {target:28} {r.get('note', '')}")


def cmd_check(args):
    data = load()
    names = [a.lower().removesuffix(".tail") for a in args] or sorted({r["name"] for r in data["routes"]} | {"gateway"})
    ctx = ssl.create_default_context(cafile=CA_CERT)
    bad = 0
    for n in names:
        host = f"{n}.tail"
        try:
            ip = socket.gethostbyname(host)
        except OSError as e:
            print(f"FAIL {host}: doesn't resolve ({e})")
            bad += 1
            continue
        paths = [r.get("path", "") for r in data["routes"] if r["name"] == n] or [""]
        for p in paths:
            url = f"https://{host}{p}/"
            try:
                req = urllib.request.Request(url, method="GET")
                with urllib.request.urlopen(req, context=ctx, timeout=8) as resp:
                    code = resp.status
            except urllib.error.HTTPError as e:
                code = e.code  # the backend answered; auth walls (401) and 404s still prove the route
            except Exception as e:
                print(f"FAIL {url} ({ip}): {e}")
                bad += 1
                continue
            # 502/504: the gateway works but nothing answers on the local port (service not running).
            status = "OK  " if code < 500 else ("DOWN" if code in (502, 504) else "FAIL")
            bad += code >= 500
            print(f"{status} {url} ({ip}) {code}")
    sys.exit(1 if bad else 0)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, args = sys.argv[1], sys.argv[2:]
    if cmd == "add":
        cmd_add(args)
    elif cmd == "rm":
        cmd_rm(args)
    elif cmd == "list":
        cmd_list(args)
    elif cmd == "check":
        cmd_check(args)
    elif cmd == "render":
        with locked():
            write_and_reload(load())
        print(CADDYFILE)
    else:
        die(f"unknown command {cmd!r}; try tailname --help", 2)


if __name__ == "__main__":
    main()
