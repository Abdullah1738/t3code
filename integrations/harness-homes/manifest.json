    {"harness": "claude", "event": "PreToolUse", "matcher": "mcp__betterstack__.*", "command": "/opt/homebrew/bin/python3 /Users/ardud/.local/share/harness-hooks/src/claude.py", "timeoutSec": 10},
    {"harness": "claude", "event": "PreToolUse", "matcher": "mcp__.*__(exec_command|shell_command)", "command": "/opt/homebrew/bin/python3 /Users/ardud/.local/share/harness-hooks/src/claude.py", "timeoutSec": 10},
    {"harness": "claude", "event": "SessionStart", "matcher": null, "command": "/opt/homebrew/bin/python3 /Users/ardud/.local/share/harness-hooks/src/claude.py", "timeoutSec": 10},
    {"harness": "codex", "event": "PreToolUse", "matcher": "Bash", "command": "/opt/homebrew/bin/python3 /Users/ardud/.local/share/harness-hooks/src/codex.py", "timeoutSec": 10},
    {"harness": "codex", "event": "PreToolUse", "matcher": "mcp__betterstack__.*", "command": "/opt/homebrew/bin/python3 /Users/ardud/.local/share/harness-hooks/src/codex.py", "timeoutSec": 10},
    {"harness": "codex", "event": "PreToolUse", "matcher": "mcp__.*__(exec_command|shell_command)", "command": "/opt/homebrew/bin/python3 /Users/ardud/.local/share/harness-hooks/src/codex.py", "timeoutSec": 10}
