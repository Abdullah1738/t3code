    {"id": "recall", "url": "http://127.0.0.1:18765/mcp", "toolTimeoutSec": 120, "startupTimeoutSec": 30},
    {"id": "perplexity", "command": "/Users/ardud/bin/perplexity-mcp", "args": [], "env": {}, "toolTimeoutSec": 660, "startupTimeoutSec": 30},
    {"id": "inbody", "command": "/Users/ardud/bin/inbody-mcp", "args": [], "env": {}, "toolTimeoutSec": 120, "startupTimeoutSec": 30},
    {"id": "flighty", "command": "/opt/homebrew/bin/uv", "args": ["--directory", "/Users/ardud/.local/share/flighty-mcp", "run", "--quiet", "main.py"], "env": {}, "toolTimeoutSec": 120, "startupTimeoutSec": 30},
    {"id": "cua-driver", "command": "/Users/ardud/.local/bin/cua-driver", "args": ["mcp"], "env": {}, "toolTimeoutSec": 120, "startupTimeoutSec": 30},
    {"id": "dia", "command": "/Users/ardud/.nvm/versions/node/v26.2.0/bin/node", "args": ["/Users/ardud/.config/opencode/dia-agent-bridge/src/server.js"], "env": {"DIA_CDP_ENDPOINT": "http://127.0.0.1:9222"}, "toolTimeoutSec": 120, "startupTimeoutSec": 30}
