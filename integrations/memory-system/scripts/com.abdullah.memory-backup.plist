<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.abdullah.memory-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-i</string><string>/bin/bash</string>
    <string>__HOME__/.local/share/memory-system/scripts/memory_backup.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ROBOB_STATE_DB</key><string>__HOME__/.robob/userdata/readonly/state.sqlite</string>
  </dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>Nice</key><integer>10</integer>
  <key>RunAtLoad</key><false/>
  <key>StartInterval</key><integer>14400</integer>
  <key>StandardOutPath</key><string>__HOME__/.local/share/memory-system/logs/backup.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/share/memory-system/logs/backup.err.log</string>
</dict>
</plist>
